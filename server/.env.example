# Sandbox developer template. The game does not load this file automatically.
# Copy outside the repository/installer and populate only in a secure test service.
# Do not paste real keys into chat, commit them, or include them in release assets.
SAR_COMMERCE_ENV=sandbox
SAR_STRIPE_SANDBOX_ENABLED=false
SAR_STRIPE_ACCOUNT_ID=
SAR_STRIPE_SECRET_KEY=
SAR_STRIPE_WEBHOOK_SECRET=
SAR_STRIPE_PAYMENT_METHOD_CONFIGURATION=
SAR_STRIPE_PRICE_MAP={}
SAR_STRIPE_RETURN_ORIGIN=http://127.0.0.1:8804

# Set a separate test database and service port; never reuse the playing account DB.
# SAR_DB_PATH=C:/private-skirmish-test/world.sqlite
# SAR_PORT=8804
# Expected secret formats: rk_test_<REDACTED> and whsec_<REDACTED>.
# PRICE_MAP needs all six verified Price IDs. Empty/unverified config stays disabled.
