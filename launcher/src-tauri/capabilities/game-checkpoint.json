{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game-checkpoint-only",
  "description": "The current account-server game may acknowledge only the one pending save checkpoint. Rust verifies its exact origin and one-use nonce.",
  "windows": ["game"],
  "local": false,
  "remote": {"urls": ["https://*/*", "http://127.0.0.1:*/*", "http://localhost:*/*"]},
  "permissions": ["allow-finish-game-checkpoint", "allow-game-fullscreen-state", "allow-set-game-fullscreen", "allow-check-local-backend", "allow-offline-local-api"]
}
