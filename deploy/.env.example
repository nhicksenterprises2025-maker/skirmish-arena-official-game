# Copy to deploy/.env on the VM. Actual values never belong in Git or an installer.
# Real DNS hostname only: no https:// prefix, port, path, or trailing slash.
SAR_PUBLIC_HOST=

# Existing account ID from the retained trusted database, not its username.
SAR_BOT_OWNER_ID=

# Generate privately before first start: a minimum of 32 random characters.
# After verifying the one-time import, set to disabled and recreate game.
SAR_CLOUD_BOOTSTRAP_TOKEN=

# Public HTTPS release directory containing exact update.json/update.json.sig.
# Use the project's existing signed release feed; never include a signing key.
SAR_UPDATE_FEED_BASE=

# Optional voice connectivity. Empty means no public NAT relay has been configured.
SAR_STUN_URL=
SAR_TURN_URLS=
SAR_TURN_SECRET=
